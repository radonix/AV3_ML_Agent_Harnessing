{
  "$schema": "https://opencode.ai/config.json",
  "model": { "providerID": "ollama", "model": "qwen3:8b" },
  "providers": {
    "ollama": {
      "name": "Ollama",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "{env:OLLAMA_BASE_URL}/v1", "apiKey": "ollama" },
      "models": {
        "qwen3:8b": {
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 65536, "output": 8192 }
        },
        "qwen3:4b": {
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 65536, "output": 8192 }
        },
        "qwen2.5:7b-instruct": {
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 65536, "output": 8192 }
        }
      }
    }
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "deny" },

    { "action": "read", "resource": "dados/*", "effect": "allow" },
    { "action": "read", "resource": "saidas/*", "effect": "allow" },
    { "action": "read", "resource": "AGENTS.md", "effect": "allow" },

    { "action": "shell", "resource": "head -n 5 dados/*", "effect": "allow" },
    { "action": "shell", "resource": "python3 scripts/validar_planilha.py *", "effect": "allow" },

    { "action": "shell", "resource": "python3 scripts/resumir_qualidade.py saidas/relatorio_qualidade.md", "effect": "allow" },
    { "action": "shell", "resource": "python3 scripts/limpar_vendas.py dados/vendas.csv -o saidas/vendas_limpas.csv --log saidas/log_limpeza.md", "effect": "allow" },
    { "action": "shell", "resource": "python3 scripts/verificar_limpeza.py dados/vendas.csv saidas/vendas_limpas.csv saidas/log_limpeza.md", "effect": "allow" },
    { "action": "shell", "resource": "head -n 5 saidas/*", "effect": "allow" },

    { "action": "shell", "resource": "* > *", "effect": "deny" },
    { "action": "shell", "resource": "* >> *", "effect": "deny" },
    { "action": "shell", "resource": "*;*", "effect": "deny" },
    { "action": "shell", "resource": "*&&*", "effect": "deny" },
    { "action": "shell", "resource": "*|*", "effect": "deny" },
    { "action": "shell", "resource": "* -o dados/*", "effect": "deny" }
  ]
}
