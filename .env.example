# Copie para .env. Variáveis já definidas no ambiente têm prioridade sobre este arquivo.

# Provedor do modelo: ollama (padrão) ou groq
PROVEDOR=ollama

# Ollama. Modelos já declarados no opencode.json: qwen3:8b, qwen3:4b, qwen2.5:7b-instruct
OLLAMA_MODEL=qwen3:8b
# O Hermes exige pelo menos 64000 tokens de contexto
OLLAMA_CONTEXT_LENGTH=65536
# Só vale fora do Docker (no Docker, o endereço é fixo no docker-compose.yml)
OLLAMA_BASE_URL=http://localhost:11434
# Só Docker: memória do container do Ollama e formato do KV cache (q4_0, q8_0 ou f16)
# OLLAMA_MEM_LIMIT=8g
# OLLAMA_KV_CACHE_TYPE=q4_0

# Só Docker no Linux: se `id -u` ou `id -g` não for 1000, informe aqui antes do build
# HOST_UID=1000
# HOST_GID=1000

# Só Docker, para usar GPU (descomente UMA linha):
# COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.amd.yml

# Só necessária com PROVEDOR=groq (console.groq.com/keys)
GROQ_API_KEY=sua_chave_aqui
